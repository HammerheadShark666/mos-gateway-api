{
  "Routes": [
    {
      "DownstreamPathTemplate": "/{version}/order/{id}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 23001
        }
      ],
      "UpstreamPathTemplate": "/{version}/order/{id}",
      "UpstreamHttpMethod": [ "GET" ],
      "DangerousAcceptAnyServerCertificateValidator": true,
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "Key": "order"
    },
    {
      "DownstreamPathTemplate": "/{version}/customer-address/{id}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 13001
        }
      ],
      "UpstreamPathTemplate": "/{version}/customer-address/{id}",
      "UpstreamHttpMethod": [ "GET" ],
      "DangerousAcceptAnyServerCertificateValidator": true,
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "Key":  "customer-address"
    },
    {
      "DownstreamPathTemplate": "/{version}/order/add",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 23001
        }
      ],
      "UpstreamPathTemplate": "/{version}/order/add",
      "UpstreamHttpMethod": [ "POST" ],
      "DangerousAcceptAnyServerCertificateValidator": true,
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    }
  ]
}